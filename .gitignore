# ---- macOS 系统文件 ----
.DS_Store

# ---- JetBrains IDE（CLion / IntelliJ IDEA / PyCharm / GoLand）----
.idea/
*.iml

# ---- 编译产物 ----
*.exe
*.obj
*.o
*.a
*.so
*.dll
*.class
*.out

# ---- Java 构建输出 ----
out/
bin/
# 例外：Rust 的 src/bin 存放题目源码，必须跟踪
!*/src/bin/
!*/src/bin/**

# ---- Python ----
__pycache__/
*.py[cod]

# ---- Node ----
node_modules/

# ---- Rust ----
target/
*.rs.bk
*.pdb

# ---- Go ----
# Go 编译产物（go run / go build 的临时文件）
*.test
vendor/
